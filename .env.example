# Deployment-specific values for a local QEMU enrollment run.
#
# Copy to `.env` (gitignored) and fill in your EST server + a bootstrap token.
# `scripts/build-buildroot-image.sh` sources `.env` and `post-build.sh`
# substitutes these into the image's /etc/hosts and /etc/nodeos/noded.yaml,
# replacing the documentation placeholders in the committed overlay
# (est.example.com / 2001:db8::61 / qemu-node-001.example.com /
# replace-with-bootstrap-token). If unset, the placeholders are kept.

# EST server hostname (the node appends /.well-known/est/<op>).
NODEOS_EST_SERVER=est.example.com

# EST server IPv6 address. Written to the image /etc/hosts so the IPv6-only node
# resolves the server without external DNS (test convenience). Omit if your node
# network has working AAAA DNS.
NODEOS_EST_SERVER_IP=2001:db8::61

# This node's FQDN (CSR CN/SAN). Must match the bootstrap token's subject.
NODEOS_NODE_ID=qemu-node-001.example.com

# Bootstrap-only EST token (short-lived, single-use). Secret — keep in .env only.
NODEOS_BOOTSTRAP_TOKEN=replace-with-bootstrap-token
